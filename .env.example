# STARGO Alibaba Inquiry AI Assistant — secrets & local-only config
# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# config/config.yaml references these as ${VAR}.

# ── Gmail (receives Alibaba Inquiry Notification emails) ─────────────────────
# Use a Gmail App Password (Google account → Security → App passwords),
# NOT your normal password. IMAP must be enabled.
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your_16_char_gmail_app_password

# ── Notion (STARGO product catalog / knowledge sync) ─────────────────────────
# Create an internal integration and share the catalog database with it.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=

# ── AI (reply drafting). Set provider: offline in config.yaml to skip this. ──
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Leave blank for the default OpenAI endpoint; set for Azure/proxy/compatible APIs.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ── WeChat notification — fill ONLY the one matching wechat.provider ─────────
# provider: serverchan
SERVERCHAN_SENDKEY=SCTxxxxxxxxxxxxxxxxxxxxxxxxx
# provider: pushplus
PUSHPLUS_TOKEN=
# provider: wecom (企业微信群机器人 webhook)
WECOM_WEBHOOK_URL=

# ── CRM (optional Google Sheet sync; SQLite is the default, no secret needed) ─
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
